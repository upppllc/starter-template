{
  "name": "sveltekit-ui-starter",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "node --test tests/*.test.js",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.4",
    "@sveltejs/kit": "^3.2.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "sveltekit-ui": "1.1.93"
  },
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "@vercel/nft": {
      "glob": "14.0.3"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
