{
  "name": "starter-template",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "node --test tests/*.test.js",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@vercel/analytics": "1.3.2",
    "classhelm": "0.3.17",
    "sveltekit-ui": "^1.1.87"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "brace-expansion": "^5.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
