# Copy to .env and use your studio's exact eight-character Classhelm slug.
# Empty by default: marketing renders; account actions make no upstream calls.
CLASSHELM_ORGANIZATION_SLUG=
# Production API by default. Only use a trusted Classhelm origin.
CLASSHELM_API_ORIGIN=https://www.classhelm.com
# Optional private storefront fingerprint secret issued for this studio.
# Never give it a PUBLIC_ prefix or put it in source/client/page data.
CLASSHELM_STOREFRONT_SHARED_SECRET=
